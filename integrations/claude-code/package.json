{
  "name": "@mubit-ai/claude-code-plugin",
  "version": "0.10.0",
  "type": "module",
  "description": "Mubit memory plugin for Claude Code — involuntary capture, pre-prompt recall, and outcome attribution.",
  "license": "Apache-2.0",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:watch": "node esbuild.config.mjs --watch",
    "clean": "rm -rf hooks/dist mcp/dist bin/impl",
    "test": "node --test 'test/**/*.test.mjs'",
    "test:dist": "MUBIT_CC_TEST_TARGET=dist node --test 'test/**/*.test.mjs'",
    "test:watch": "node --test --watch 'test/**/*.test.mjs'",
    "lint": "node --check hooks/src/*.mjs lib/*.mjs bin/*.mjs mcp/src/*.mjs",
    "verify": "npm run clean && npm run build && npm run test && npm run test:dist && node scripts/verify-manifests.mjs",
    "context-cost": "node scripts/measure-context-cost.mjs",
    "prepack": "npm run build"
  },
  "files": [".claude-plugin", "hooks/hooks.json", "hooks/dist", "mcp/dist", "skills",
            "agents", "bin", ".mcp.json", "settings.json", "README.md", "LICENSE",
            "THIRD_PARTY_NOTICES.md"],
  "dependencies": {},
  "devDependencies": { "esbuild": "^0.28.0", "@mubit-ai/mcp": "file:../mcp" }
}
