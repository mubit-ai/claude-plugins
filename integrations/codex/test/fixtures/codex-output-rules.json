{
  "_comment": [
    "The constraints this plugin holds its own hook output to, per event.",
    "",
    "Two kinds live here. `rules` are semantic: things a hook must not write, which the host",
    "rejects at parse time rather than at the wire-format layer. `capabilities` are structural:",
    "which channels an event has at all, which is what decides where a handler is allowed to put",
    "something it wants the model to see.",
    "",
    "`message` is the sentence a failing assertion quotes, so a failure reads as what a user",
    "would have been shown rather than as a paraphrase of it.",
    "",
    "This is the plugin's stated contract, not the host's schema. The externally-verified part",
    "of it is `observed/output-acceptance.json`, recorded by emitting an output from a real",
    "session and reading the verdict; `codex-payload.test.mjs` cross-checks the two so the",
    "contract cannot drift away from the observation without a test saying so.",
    "",
    "One honest limit: `forbidden` is asserted on the PRESENCE of the key, not on its value. The",
    "host may well accept `suppressOutput: false`; the fix removes the key outright, so the",
    "distinction cannot change the implementation."
  ],
  "_provenance": {
    "kind": "the plugin's own output contract",
    "verified_subset": "test/fixtures/observed/output-acceptance.json",
    "codex_version_last_checked": "codex-cli 0.149.0",
    "checked": "2026-08-24",
    "recheck": "node test/helpers/codex-record.mjs --update --probe <key>"
  },
  "capabilities": {
    "_comment": [
      "Which output channels each event has. Only the three facts the plugin's handlers turn on",
      "are recorded — an event's full field inventory is the host's business, and a handler that",
      "needed one would be reaching past its own contract.",
      "",
      "`hasOutputWireType: false` means the event parses no output at all beyond a bare JSON",
      "object. `emitsAdditionalContext` is the one that decides handler design: without it there",
      "is no way to put text in front of the model, so the handler either decides or observes.",
      "`decisionOnly` marks an event whose only structured channel is a verdict."
    ],
    "PreToolUse": {
      "hasOutputWireType": true,
      "hasHookSpecificOutput": true,
      "emitsAdditionalContext": true
    },
    "PermissionRequest": {
      "hasOutputWireType": true,
      "hasHookSpecificOutput": true,
      "emitsAdditionalContext": false,
      "decisionOnly": true
    },
    "PostToolUse": {
      "hasOutputWireType": true,
      "hasHookSpecificOutput": true,
      "emitsAdditionalContext": true
    },
    "PreCompact": {
      "hasOutputWireType": true,
      "hasHookSpecificOutput": false,
      "emitsAdditionalContext": false
    },
    "PostCompact": {
      "hasOutputWireType": true,
      "hasHookSpecificOutput": false,
      "emitsAdditionalContext": false
    },
    "SessionStart": {
      "hasOutputWireType": true,
      "hasHookSpecificOutput": true,
      "emitsAdditionalContext": true
    },
    "SessionEnd": {
      "hasOutputWireType": false,
      "hasHookSpecificOutput": false,
      "emitsAdditionalContext": false
    },
    "UserPromptSubmit": {
      "hasOutputWireType": true,
      "hasHookSpecificOutput": true,
      "emitsAdditionalContext": true
    },
    "SubagentStart": {
      "hasOutputWireType": true,
      "hasHookSpecificOutput": true,
      "emitsAdditionalContext": true
    },
    "SubagentStop": {
      "hasOutputWireType": true,
      "hasHookSpecificOutput": false,
      "emitsAdditionalContext": false
    },
    "Stop": {
      "hasOutputWireType": true,
      "hasHookSpecificOutput": false,
      "emitsAdditionalContext": false
    }
  },
  "rules": {
    "*": [
      {
        "kind": "nonEmptyWhen",
        "field": "reason",
        "when": "decision",
        "equals": "block",
        "message": "<Event> hook returned decision:block without a non-empty reason"
      }
    ],
    "PreToolUse": [
      {
        "kind": "forbidden",
        "field": "suppressOutput",
        "message": "PreToolUse hook returned unsupported suppressOutput"
      },
      {
        "kind": "forbidden",
        "field": "stopReason",
        "message": "PreToolUse hook returned unsupported stopReason"
      },
      {
        "kind": "forbiddenValue",
        "field": "continue",
        "value": false,
        "message": "PreToolUse hook returned unsupported continue:false"
      },
      {
        "kind": "forbiddenValue",
        "field": "decision",
        "value": "approve",
        "message": "PreToolUse hook returned unsupported decision:approve"
      },
      {
        "kind": "forbiddenValue",
        "field": "hookSpecificOutput.permissionDecision",
        "value": "ask",
        "message": "PreToolUse hook returned unsupported permissionDecision:ask"
      },
      {
        "kind": "forbiddenValue",
        "field": "hookSpecificOutput.permissionDecision",
        "value": "allow",
        "message": "PreToolUse hook returned unsupported permissionDecision:allow"
      },
      {
        "kind": "requiresField",
        "field": "reason",
        "needs": "decision",
        "message": "PreToolUse hook returned reason without decision"
      },
      {
        "kind": "requiresField",
        "field": "hookSpecificOutput.permissionDecisionReason",
        "needs": "hookSpecificOutput.permissionDecision",
        "message": "PreToolUse hook returned permissionDecisionReason without permissionDecision"
      },
      {
        "kind": "requiresValue",
        "field": "hookSpecificOutput.updatedInput",
        "needs": "hookSpecificOutput.permissionDecision",
        "value": "allow",
        "message": "PreToolUse hook returned updatedInput without permissionDecision:allow"
      },
      {
        "kind": "nonEmptyWhen",
        "field": "hookSpecificOutput.permissionDecisionReason",
        "when": "hookSpecificOutput.permissionDecision",
        "equals": "deny",
        "message": "PreToolUse hook returned permissionDecision:deny without a non-empty permissionDecisionReason"
      }
    ],
    "PostToolUse": [
      {
        "kind": "forbidden",
        "field": "suppressOutput",
        "message": "PostToolUse hook returned unsupported suppressOutput"
      },
      {
        "kind": "forbidden",
        "field": "hookSpecificOutput.updatedMCPToolOutput",
        "message": "PostToolUse hook returned unsupported updatedMCPToolOutput"
      },
      {
        "kind": "requiresField",
        "field": "reason",
        "needs": "decision",
        "message": "PostToolUse hook returned reason without decision"
      }
    ],
    "PermissionRequest": [
      {
        "kind": "forbidden",
        "field": "suppressOutput",
        "message": "PermissionRequest hook returned unsupported suppressOutput"
      },
      {
        "kind": "forbidden",
        "field": "stopReason",
        "message": "PermissionRequest hook returned unsupported stopReason"
      },
      {
        "kind": "forbiddenValue",
        "field": "continue",
        "value": false,
        "message": "PermissionRequest hook returned unsupported continue:false"
      },
      {
        "kind": "forbidden",
        "field": "hookSpecificOutput.decision.updatedInput",
        "message": "PermissionRequest hook returned unsupported updatedInput"
      },
      {
        "kind": "forbidden",
        "field": "hookSpecificOutput.decision.updatedPermissions",
        "message": "PermissionRequest hook returned unsupported updatedPermissions"
      },
      {
        "kind": "forbiddenValue",
        "field": "hookSpecificOutput.decision.interrupt",
        "value": true,
        "message": "PermissionRequest hook returned unsupported interrupt:true"
      }
    ]
  }
}
